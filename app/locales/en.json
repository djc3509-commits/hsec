        "3": {
          "title": "Community & News",
          "desc": "Post analysis, tag $coins, like and comment. Crypto news feed with trending filter."
        },
        "4": {
          "title": "Streaming AI Chat",
          "desc": "Integrated with Groq (Llama 3.3) with streaming responses. Chat about markets and how to use the app."
        },
        "5": {
          "title": "Analytics Dashboard",
          "desc": "Total assets, P&L variation, transaction cash flow, market sentiment. Filter by custom date range."
        }
      }
