  "analyst": {
    "glossary": {
      "winRate": {
        "name": "Win Rate",
        "desc": "Percentage of closed recommendations that hit Take Profit, over all closed recommendations."
      },
      "pnl": {
        "name": "PnL (Profit & Loss)",
        "desc": "Total profit (positive) or loss (negative) accumulated from closed recommendations."
      },
      "bestTrade": {
        "name": "Best Trade",
        "desc": "The recommendation with the highest profit in your whole history."
      },
      "open": {
        "name": "Open Positions",
        "desc": "Number of recommendations still open, waiting for price to hit TP/SL."
      },
      "equity": {
        "name": "Equity Curve",
        "desc": "Simulated capital over time if you had followed every AI recommendation."
      },
      "horizon": {
        "name": "Horizon / Timeframe",
        "desc": "Expected holding time: Scalp (hours) · Day (1-3 days) · Swing (1-2 weeks) · Position (1-3 months)."
      },
      "direction": {
        "name": "Direction",
        "desc": "Expected price direction: LONG = bet price rises, SHORT = bet price falls."
      },
      "confidence": {
        "name": "Confidence",
        "desc": "AI-estimated probability for the predicted direction (about 50-85%). Never an absolute certainty."
      },
      "entry": {
        "name": "Entry Price",
        "desc": "The price the AI suggests opening the position at."
      },
      "exit": {
        "name": "Exit Price",
        "desc": "The actual price the position was closed at (when TP/SL hit or closed manually). A \"—\" means not closed yet."
      },
      "stopLoss": {
        "name": "Stop Loss (SL)",
        "desc": "The price to close the position at to cap the loss if price moves against the prediction."
      },
      "takeProfit": {
        "name": "Take Profit (TP)",
        "desc": "The price to close the position at to realize profit when price moves as predicted."
      },
      "positionSize": {
        "name": "Position Size",
        "desc": "Quantity of coin in the position (already multiplied by leverage)."
      },
      "leverage": {
        "name": "Leverage",
        "desc": "Position multiplier. x1 = no leverage (spot); x10 = position 10x your capital, profit/loss both multiplied by 10."
      },
      "notional": {
        "name": "Notional Value",
        "desc": "Total position value = capital × leverage."
      },
      "liquidation": {
        "name": "Liquidation Price",
        "desc": "The price at which a leveraged position is force-closed (liquidated). Set SL before this level."
      },
      "riskReward": {
        "name": "Risk / Reward",
        "desc": "Ratio between max loss (to SL) and expected gain (to TP)."
      },
      "long": {
        "name": "Long",
        "desc": "A position expecting price to RISE — profit when price goes up, loss when it goes down."
      },
      "short": {
        "name": "Short",
        "desc": "A position expecting price to FALL — profit when price goes down, loss when it goes up."
      },
      "scalp": {
        "name": "Scalp",
        "desc": "Hold for a few hours, capture small moves. SL ~1.5%, TP ~2.5%."
      },
      "day": {
        "name": "Day Trade",
        "desc": "Hold for 1-3 days. SL ~3%, TP ~5%."
      },
      "swing": {
        "name": "Swing Trade",
        "desc": "Hold for 1-2 weeks following the price swing. SL ~5%, TP ~10%."
      },
      "position": {
        "name": "Position Trade",
        "desc": "Hold for 1-3 months following the major trend. SL ~10%, TP ~30%."
      },
      "HIT_TP": {
        "name": "Hit Take Profit",
        "desc": "Price reached the take-profit target (TP) → winning recommendation."
      },
      "HIT_SL": {
        "name": "Hit Stop Loss",
        "desc": "Price reached the stop-loss level (SL) → losing recommendation."
      },
      "EXPIRED": {
        "name": "Expired",
        "desc": "Expected timeframe elapsed without hitting TP/SL → closed at current price."
      }
    },
