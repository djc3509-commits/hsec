      "description": "This is a personal project — below is everything that's been built and is currently running.",
      "items": {
        "0": {
          "title": "Order Book",
          "desc": "Displays 20 price levels around the spread, refreshing every 1.5s. Click a price to auto-fill the order form."
        },
        "1": {
          "title": "Candlestick Charts",
          "desc": "Integrated Lightweight Charts with multiple timeframes (1m–1M). Kline data pulled from Binance's public API."
        },
        "2": {
          "title": "Wallet & Portfolio",
          "desc": "Track USDT balance, per-coin holdings, and P&L by period (daily/weekly/monthly). Allocation donut included."
