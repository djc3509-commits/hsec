# Chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ── Database (PostgreSQL) — BẮT BUỘC ─────────────────────────
# Định dạng: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Cần SSL (Neon, Supabase, RDS…) thì thêm ?sslmode=require vào cuối.
DATABASE_URL=postgres://hsec_app:doi-mat-khau@localhost:5432/hsec

# ── Auth — BẮT BUỘC ──────────────────────────────────────────
# Chuỗi ngẫu nhiên >= 32 ký tự. Sinh nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI (Groq) — BẮT BUỘC ────────────────────────────────────
# Key cho Chat AI
GROQ_API_KEY=
# Key RIÊNG cho AI Analyst (tách quota với Chat)
GROQ_API_KEY_ANALYST=
# ANALYST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ANALYST_MAX_TOKENS=3000

# ── Cloudinary (ảnh bài viết + ảnh đại diện) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
